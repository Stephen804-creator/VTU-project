# ==========================================
# SUBSCRIBE ME CONFIGURATION
# ==========================================

APP_NAME=Subscribe Me

APP_ENV=development

SECRET_KEY=change-this-secret-key

# ==========================================
# DATABASE
# ==========================================

DATABASE_PATH=data/subscribe_me.db

# ==========================================
# PAIRGATE
# ==========================================

PAIRGATE_API_KEY=your_pairgate_api_key_here

PAIRGATE_BASE_URL=https://pairgate.com/api/v1

# true = test mode
# false = live mode
PAIRGATE_TEST_MODE=true

# ==========================================
# APPLICATION
# ==========================================

PORT=5000
