APP_NAME=Subscribe Me
APP_ENV=development
# Generate a unique value with: python -c "import secrets; print(secrets.token_hex(32))"
# Required in production; never commit a real secret.
SECRET_KEY=replace-with-a-random-secret-of-at-least-32-characters
DATABASE_PATH=data/subscribe_me.db

PAIRGATE_API_KEY=your_pairgate_api_key_here
PAIRGATE_BASE_URL=https://pairgate.com/api/v1
PAIRGATE_TEST_MODE=true

# Pairgate signs: timestamp + "." + exact raw request body, using HMAC-SHA256.
PAIRGATE_WEBHOOK_SECRET=your_pairgate_webhook_secret_here
# Local-only bypass. Production always enforces verification.
PAIRGATE_WEBHOOK_VERIFY=true
PAIRGATE_WEBHOOK_TOLERANCE_SECONDS=300

PAYSTACK_SECRET_KEY=your_paystack_secret_key_here
PAYSTACK_BASE_URL=https://api.paystack.co
PAYSTACK_TEST_MODE=true

PORT=5000
